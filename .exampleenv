# Add these environment variables to your .env.local file:

# Existing variables (keep these)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# New Resend configuration
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_REPLY_TO=your-email@yourdomain.com

# Optional: Custom domain for emails (if you have a custom domain set up in Resend)
# RESEND_FROM_EMAIL=noreply@nudgr.yourdomain.com

# Add these to your existing .env.local
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SCHEDULER_API_KEY=scheduler_secret_key_123

# Add this line to your existing .env.local
RAZORPAY_WEBHOOK_SECRET=temp_secret_for_now